# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# --- Ghostkey ---

# .vscode/ is deliberately NOT ignored (the commented-out rule above stays
# commented): launch.json carries the staging / prod / LAN --dart-define
# configurations, and without it a fresh checkout builds an app that fails on
# its first server read. It holds no secret — the server URLs are public.

# Debug APKs copied out of build/ to hand to a phone.
*.apk
*.aab

# Flutter's per-machine SDK + Android SDK paths. android/.gitignore already
# covers android/local.properties; this catches a stray one at the root.
/local.properties
