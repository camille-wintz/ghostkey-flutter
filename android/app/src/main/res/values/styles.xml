<?xml version="1.0" encoding="utf-8"?>
<!-- The app is night only, so there is no values-night twin of this file: both
     themes are dark whatever the OS is set to, and the window is Ds.void_ from
     the first frame Android draws through to the first frame Flutter draws. -->
<resources>
    <!-- The window while the process is starting. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- The window behind the Flutter UI, from the moment the engine takes over. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/gk_void</item>
    </style>
</resources>
